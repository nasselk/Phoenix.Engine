{
	"linter": {
		"enabled": false,
		"rules": {
			"suspicious": {
				"noExplicitAny": "off",
				"noShadowRestrictedNames": "off"
			},
			"complexity": {
				"noThisInStatic": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 320,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"semicolons": "always",
			"quoteStyle": "double"
		}
	},
	"files": {
		"includes": ["**/*.*", "!**/node_modules", "!**/dist", "!**/builds", "!**/*.svelte"]
	}
}
