{
	"name": "phoenix.engine",
	"author": "nasselk",
	"description": "Typescript multiplayer game engine",
	"version": "1.0.179",
	"type": "module",
	"private": true,
	"exports": {
		".": {
			"types": "./dist/shared/src/index.d.ts",
			"import": "./dist/shared/src/index.js"
		},
		"./client": {
			"types": "./dist/client/src/index.d.ts",
			"import": "./dist/client/index.js"
		},
		"./server": {
			"types": "./dist/server/src/index.d.ts",
			"import": "./dist/server/src/index.js"
		}
	},
	"workspaces": [
		"client",
		"server",
		"shared"
	],
	"engines": {
		"node": ">=22.0.0 <23.0.0 || >=24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nasselk/Phoenix.Engine.git"
	},
	"bugs": {
		"url": "https://github.com/nasselk/Phoenix.Engine/issues",
		"email": "nassim.elkarati@gmail.com"
	},
	"homepage": "https://github.com/nasselk/Phoenix.Engine",
	"scripts": {
		"init": "bun install",
		"build": "tsc",
		"build:client": "cd client && bun run build",
		"build:server": "cd server && bun run build",
		"types:check": "tsc --noEmit",
		"format": "biome format --write",
		"prepare": "husky || true"
	},
	"peerDependencies": {
		"pixi.js": "^8.0.0",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"pixi.js": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/bun": "^1.3.14",
		"husky": "^9.1.7",
		"pixi.js": "^8.19.0",
		"svelte": "^5.56.4",
		"typescript": "^7.0.2"
	}
}
