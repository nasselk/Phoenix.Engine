{
	"name": "phoenix.engine",
	"author": "nasselk",
	"description": "Typescript multiplayer game engine",
	"version": "1.1.0",
	"type": "module",
	"private": true,
	"exports": {
		".": {
			"types": "./dist/shared/index.d.ts",
			"import": "./dist/shared/index.js"
		},
		"./client": {
			"types": "./dist/client/src/index.d.ts",
			"import": "./dist/client/src/index.js"
		},
		"./text": {
			"types": "./dist/client/src/text/index.d.ts",
			"import": "./dist/client/src/text/index.js"
		},
		"./server": {
			"types": "./dist/server/src/index.d.ts",
			"import": "./dist/server/src/index.js"
		},
		"./native.css": "./client/src/UI/native.css",
		"./ui/*.svelte": {
			"types": "./client/src/UI/components/*/*.svelte.d.ts",
			"svelte": "./client/src/UI/components/*/*.svelte",
			"default": "./client/src/UI/components/*/*.svelte"
		}
	},
	"workspaces": [
		"client",
		"server"
	],
	"engines": {
		"node": ">=22.0.0 <23.0.0 || >=24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nasselk/Phoenix.Engine.git"
	},
	"bugs": {
		"url": "https://github.com/nasselk/Phoenix.Engine/issues",
		"email": "nassim.elkarati@gmail.com"
	},
	"homepage": "https://github.com/nasselk/Phoenix.Engine",
	"scripts": {
		"init": "bun install",
		"build": "rm -rf dist && bun run build:client && bun run build:server",
		"build:client": "rm -rf dist/client dist/client.tsconfig.tsbuildinfo && cd client && bun run build",
		"build:server": "rm -rf dist/server dist/server.tsconfig.tsbuildinfo && cd server && bun run build",
		"release": "bun ./scripts/release.ts",
		"types:check": "bun run --sequential --no-exit-on-error types:client types:server",
		"types:client": "cd client && bun run types:check",
		"types:server": "cd server && bun run types:check",
		"biome:check": "biome check --write",
		"prepare": "husky || true"
	},
	"dependencies": {
		"@lucide/svelte": "^1.70.0",
		"@nasselk/binarypack": "github:nasselk/BinaryPack#1.0.0",
		"howler": "^2.2.4",
		"@types/howler": "^2.2.13",
		"stats.js": "^0.17.0",
		"@types/stats.js": "^0.17.4",
		"troika-three-text": "^0.53.1"
	},
	"devDependencies": {
		"@nasselk/binaryschema": "github:nasselk/BinarySchema#v1.0.0",
		"@biomejs/biome": "2.6.4",
		"@dimforge/rapier3d-simd-compat": "^0.21.0",
		"@types/bun": "^1.4.4",
		"@types/three": "^0.187.0",
		"husky": "^9.1.7",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"@dimforge/rapier3d-simd-compat": "^0.21.0",
		"three": "^0.187.0",
		"svelte": "^5.57.3"
	},
	"peerDependenciesMeta": {
		"three": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	}
}
